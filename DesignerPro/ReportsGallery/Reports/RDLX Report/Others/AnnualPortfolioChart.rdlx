								</Style>
								<ZIndex>2</ZIndex>
								<CanGrow>true</CanGrow>
								<Value>="Currency in " + First(Fields!Currency.Value, "DailyTrading")</Value>
							</Textbox>
							<Textbox Name="TextBox18">
								<Top>0.5in</Top>
								<Left>0.1in</Left>
								<Width>3.2in</Width>
								<Height>0.2in</Height>
								<Style>
