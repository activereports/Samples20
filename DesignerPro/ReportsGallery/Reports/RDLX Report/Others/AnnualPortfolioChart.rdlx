									<PaddingTop>2pt</PaddingTop>
								</Style>
								<ZIndex>3</ZIndex>
								<CanGrow>true</CanGrow>
								<Value>="Range (Quotes):   " + Min(Fields!Low.Value, "DailyTrading") + " - " + Max(Fields!High.Value, "DailyTrading")</Value>
							</Textbox>
							<Textbox Name="TextBox19">
