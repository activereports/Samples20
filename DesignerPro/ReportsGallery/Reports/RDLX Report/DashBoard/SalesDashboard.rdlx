									<IconColor>Black</IconColor>
									<MaxHeight>1</MaxHeight>
									<MaxWidth>1</MaxWidth>
									<Mode>Custom</Mode>
								</ShapeSeries>
							</Plot>
						</Plots>
					</Chart>
				</ReportItems>
				<Style>
					<BackgroundColor>DimGray</BackgroundColor>
				</Style>
			</Body>
			<Page>
				<PaperOrientation>Landscape</PaperOrientation>
				<PageHeight>29.7cm</PageHeight>
				<PageWidth>42cm</PageWidth>
			</Page>
			<Width>42cm</Width>
			<DataElementName>ReportSection1</DataElementName>
			<CustomProperties>
				<CustomProperty>
					<Name>PaperKind</Name>
					<Value>A3Rotated</Value>
				</CustomProperty>
			</CustomProperties>
		</ReportSection>
	</ReportSections>
	<DataSources>
		<DataSource Name="Sales">
			<ConnectionProperties>
				<ConnectString>data source=..\\..\\..\\..\\..\\..\\..\\..\\Data\\SalesResult.db</ConnectString>
				<DataProvider>SQLITE</DataProvider>
			</ConnectionProperties>
		</DataSource>
	</DataSources>
	<DataSets>
		<DataSet Name="SalesResult">
			<Fields>
				<Field Name="ProductGroup">
					<DataField>ProductGroup</DataField>
				</Field>
				<Field Name="Sales">
					<DataField>Sales</DataField>
				</Field>
				<Field Name="ProductNm">
					<DataField>ProductNm</DataField>
				</Field>
				<Field Name="Category">
					<DataField>Category</DataField>
				</Field>
				<Field Name="Platform">
					<DataField>Platform</DataField>
				</Field>
				<Field Name="PMonth">
					<DataField>PMonth</DataField>
				</Field>
				<Field Name="FY">
					<DataField>FY</DataField>
				</Field>
				<Field Name="TargetValue">
					<DataField>TargetValue</DataField>
				</Field>
			</Fields>
			<Query>
				<CommandText>select M01Product.ProductGroup as ProductGroup, Sum(M01Product.ProductPricePKG1 * Quantity) as Sales, MAX(M01Product.ProductNm) as ProductNm, M01Product.Category as Category, M01Product.Platform as Platform,  strftime('%m', T01Result.PDate) as PMonth, T01Result.FY as FY, MAX(T03Target.TargetValue) as TargetValue
from (M01Product inner join T01Result on M01Product.ProductID = T01Result.ProductID) inner join T03Target on strftime('%Y%m', T01Result.PDate) = strftime('%Y%m', T03Target.TargetMonth)
group by M01Product.ProductGroup, M01Product.Category, M01Product.Platform,  T01Result.PDate, T01Result.FY
order by T01Result.PDate</CommandText>
				<DataSourceName>Sales</DataSourceName>
			</Query>
		</DataSet>
		<DataSet Name="TrialDLNum">
			<Fields>
				<Field Name="ProductGroup">
					<DataField>ProductGroup</DataField>
				</Field>
				<Field Name="DLDate">
					<DataField>DLDate</DataField>
				</Field>
				<Field Name="DLNum">
					<DataField>DLNum</DataField>
				</Field>
				<Field Name="DLMonth">
					<Value>=Fields!DLDate.Value.Month</Value>
				</Field>
			</Fields>
			<Query>
				<CommandText>select MAX(M01Product.ProductGroup) as ProductGroup, T02TrialDL.DLDate as DLDate, Sum(T02TrialDL.DLNum) as DLNum
from M01Product inner join T02TrialDL on M01Product.ProductID = T02TrialDL.ProductID
group by M01Product.ProductGroup, T02TrialDL.DLDate</CommandText>
				<DataSourceName>Sales</DataSourceName>
			</Query>
		</DataSet>
	</DataSets>
	<CustomProperties>
		<CustomProperty>
			<Name>PaperOrientation</Name>
			<Value>Landscape</Value>
		</CustomProperty>
	</CustomProperties>
</Report>