<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
    <ActiveReportsConfig>
        <DataProviders>
            <add name="SQLITE"
             type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite"
             displayName="SQLite Provider" />
        </DataProviders>
        <CustomReportItems>
            <RuntimeComponents>
                <add name="RadarChart"
                 type="ActiveReports.Samples.Radar.RadarChart, ActiveReports.Samples.RadarChart" />
            </RuntimeComponents>
        </CustomReportItems>
        <Settings>
            <add key="ScriptExecutionPolicy" value="Disabled" />
        </Settings>
    </ActiveReportsConfig>
    <ActiveReportsConfig.Desktop>
        <CustomReportItems>
            <DesignComponents>
                <add name="RadarChart"
                 type="ActiveReports.Samples.Radar.RadarDesigner, ActiveReports.Samples.RadarDesigner"
                 toolboxIcon="ActiveReports.Samples.Radar.RadarIcon.png" />
            </DesignComponents>
        </CustomReportItems>
        <Settings>
            <add key="Viewer.EnableFontSmoothing" value="false" />
        </Settings>
    </ActiveReportsConfig.Desktop>
</Configuration>