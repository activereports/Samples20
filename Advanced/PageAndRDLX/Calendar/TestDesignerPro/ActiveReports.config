<?xml version="1.0" encoding="utf-8" ?>
<Configuration>
    <ActiveReportsConfig>
        <DataProviders>
            <add name="SQLITE"
             type="System.Data.SQLite.SQLiteFactory, System.Data.SQLite"
             displayName="SQLite Provider" />
            <add name="MYSQL"
             type="MySqlConnector.MySqlConnectorFactory, MySqlConnector"
             displayName="MySQL Provider" />
            <add name="POSTGRESQL"
             type="Npgsql.NpgsqlFactory, Npgsql"
             displayName="PostgreSQL Provider" />
            <add name="EXCEL"
             type="GrapeCity.ActiveReports.Core.DataProviders.Excel.ExcelDataProviderFactory, MESCIUS.ActiveReports.Core.DataProviders.Excel"
             displayName="Excel Provider" />
        </DataProviders>
        <CustomReportItems>
            <RuntimeComponents>
                <add name="Calendar"
                 type="ActiveReports.Calendar.Components.Calendar.CalendarDataRegion, ActiveReports.Calendar.Component" />
            </RuntimeComponents>
        </CustomReportItems>
    </ActiveReportsConfig>
    <ActiveReportsConfig.Desktop>
        <CustomReportItems>
            <DesignComponents>
                <add name="Calendar"
                 type="ActiveReports.Calendar.Design.Designers.CalendarDesigner, ActiveReports.Calendar.Designer"
                 toolboxIcon="ActiveReports.Calendar.Resources.CalendarToolboxIcon.bmp" />
            </DesignComponents>
        </CustomReportItems>
        <ReportWizardReportTypes>
            <clear />
            <add name="RdlMultiSection" />
            <add name="Page" />
        </ReportWizardReportTypes>
        <Settings>
            <add key="Designer.DefaultReportType" value="RdlMultiSection" />
            <add key="Viewer.EnableFontSmoothing" value="false" />
        </Settings>
    </ActiveReportsConfig.Desktop>
</Configuration>